# AK Vision AI - Local Development Environment

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://akvision_app:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/ak_vision_ai
# Comma-separated frontend origins allowed by the production API.
# Example:
# CORS_ORIGINS=https://app.akvision.ai,https://admin.akvision.ai
CORS_ORIGINS=

# Password reset email delivery
# Development/test: if unset, the API logs the reset link locally.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
